        {
          "id": "snap",
          "type": "snapshot"
        },
        {
          "id": "files",
          "type": "list_files",
          "expect_true": {
            "files": true
          }
        },
        {
          "id": "pub",
          "type": "publish",
          "token_path": "rec.result.staging_pending.0.token",
          "expected_active_gen": null,
          "old_valid_ms": 0,
          "expect_fields": {
            "gen": 1,
            "replayed": false
          }
        },
        {
          "id": "s",
          "type": "sign",
          "request_id": "req-both",
          "event": "ops:both",
          "expect_fields": {
            "gen": 1
          }
        }
      ]
    },
