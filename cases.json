          "action": "kill"
        },
        {
          "id": "wr",
          "type": "worker_result",
          "proc": "worker1",
          "expect_error": "E_WORKER_KILLED"
        },
        {
          "id": "rec",
          "type": "recover",
          "expect_true": {
            "staging_pending": true
          },
          "expect_fields": {
            "orphan_files_removed.__len__": 0
          }
