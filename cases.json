{
  "schema": "key-rotation-cases/v1",
  "description": "本地服务签名密钥轮换验证器可重放用例（全部输入为合成测试数据）",
  "clock_start_ms": 1700000000000,
  "cases": [
    {
      "case_id": "01_happy_rotation",
      "group_id": "grp_happy",
      "steps": [
        {
          "id": "g",
          "type": "create_group"
        },
        {
          "id": "p1",
          "type": "prepare",
          "seed": "seed-happy",
          "expect_fields": {
            "gen": 1,
            "committed": true
          }
        },
        {
          "id": "pub1",
          "type": "publish",
          "token": "$refs.p1",
          "expected_active_gen": null,
          "old_valid_ms": 10000,
          "expect_fields": {
            "gen": 1,
            "replayed": false
          }
        },
        {
          "id": "s1",
          "type": "sign",
          "request_id": "req-1",
          "event": "ops:event-a",
          "expect_fields": {
            "gen": 1,
            "replayed": false
          }
        },
        {
          "id": "v1",
          "type": "verify",
          "gen": 1,
          "mac": "$refs.s1",
          "event": "ops:event-a",
          "expect_valid": true
        },
        {
          "id": "p2",
          "type": "prepare",
          "seed": "seed-happy-2",
          "expect_fields": {
            "gen": 2
          }
        },
        {
          "id": "pub2",
          "type": "publish",
          "token": "$refs.p2",
          "expected_active_gen": 1,
          "old_valid_ms": 10000,
          "expect_fields": {
            "gen": 2,
            "old_gen": 1
          }
        },
        {
          "id": "s2",
          "type": "sign",
          "request_id": "req-2",
          "event": "ops:event-b",
          "expect_fields": {
            "gen": 2
          }
        },
        {
          "id": "v_old_ok",
          "type": "verify",
          "gen": 1,
          "mac": "$refs.s1",
          "event": "ops:event-a",
          "expect_valid": true
        },
        {
          "id": "v_other_ev",
          "type": "verify",
          "gen": 1,
          "mac": "$refs.s2",
          "event": "ops:event-b",
          "expect_valid": false
        },
        {
          "id": "snap",
          "type": "snapshot",
          "expect_fields": {
            "active_gen": 2,
            "old_gen": 1
          }
        },
        {
          "id": "files",
          "type": "list_files",
          "expect_true": {
            "files": true
          }
        }
      ]
    },
    {
      "case_id": "02_kill_half_written_file",
      "group_id": "grp_half",
      "steps": [
        {
          "id": "g",
          "type": "create_group"
        },
        {
          "id": "w",
          "type": "worker_spawn",
          "proc": "worker1",
          "op": "prepare",
          "seed": "seed-half",
          "hook": "prepare.mid_first_write"
        },
        {
          "id": "kill",
          "type": "worker_gate",
          "proc": "worker1",
          "spawn_step": "w",
          "hook": "prepare.mid_first_write",
          "action": "kill"
        },
        {
          "id": "wr",
          "type": "worker_result",
          "proc": "worker1",
          "expect_error": "E_WORKER_KILLED"
        },
        {
          "id": "files1",
          "type": "list_files"
        },
        {
          "id": "rec",
          "type": "recover",
          "expect_true": {
            "tmp_files_removed": true
          }
        },
        {
          "id": "snap",
          "type": "snapshot"
        },
        {
          "id": "p2",
          "type": "prepare",
          "seed": "seed-half-retry",
          "expect_fields": {
            "gen": 2
          }
        },
        {
          "id": "files2",
          "type": "list_files",
          "expect_true": {
            "files": true
          }
        }
      ]
    },
    {
      "case_id": "03_kill_after_both_written",
